ody.raw_text#}}\n\n已通过规则提取到的部分字段：\n- 商户名称: {{#1782813119190.body.vendor_name#}}\n- 票据编号: {{#1782813119190.body.receipt_number#}}\n- 日期: {{#1782813119190.body.date#}}\n- 总金额: {{#1782813119190.body.total_amount#}}\n- 税额: {{#1782813119190.body.tax_amount#}}\n\n请补充以下未提取到的字段（如果能从文本中找到的话）：\n1. 商户名称（如果上面为空）\n2. 票据编号/发票号码\n3. 日期\n4. 商品/服务明细\n\n请以 JSON 格式输出：\n{\"vendor_name\": null, \"receipt_number\": null, \"date\": null, \"items\": []}\n"}, {"role": "user", "text": "请从上述OCR文本中提取补充字段。只输出JSON，不要其他内容。"}], "selected": false, "title": "LLM兜底提取", "type": "llm", "variables": [], "vision": {"enabled": false}}, "height": 96, "id": "1782813119193", "position": {"x": 1310, "y": 60}, "positionAbsolute": {"x": 1310, "y": 60}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 244}, {"data": {"code": "def main(ocr_data: dict, llm_fallback: dict = None) -> dict:\n    \"\"\"\n    格式化增值税发票输出\n    \"\"\"\n    result = {\n        \"status\": \"success\",\n        \"type\": \"增值税发票\",\n        \"vendor\": ocr_data.get(\"vendor_name\") or (llm_fallback.get(\"vendor_name\") if llm_fallback else None) or \"未知\",\n        \"invoice_number\": ocr_data.get(\"receipt_number\") or (llm_fallback.get(\"receipt_number\") if llm_fallback else None) or \"\",\n        \"date\": ocr_data.get(\"date\") or (llm_fallback.get(\"date\") if llm_fallback else None) or \"\",\n        \"total\": ocr_data.get(\"total_amount\"),\n        \"tax\": ocr_data.get(\"tax_amount\"),\n        \"currency\": ocr_data.get(\"currency\", \"CNY\"),\n        \"items\": ocr_data.get(\"items\", []),\n        \"confidence\": round(ocr_data.get(\"confidence\", 0) * 100, 1),\n        \"processing_time\": ocr_data.get(\"processing_time\", 0),\n        \"warnings\": ocr_data.get(\"warnings\", []),\n        \"suggested_action\": \"请核对金额与发票原件是否一致\"\n    }\n    return result\n", "code_language": "python3", "desc": "格式化增值税发票的识别结果", "outputs": [{"children": null, "name": "status", "type": "string"}, {"children": null, "name": "type", "type": "string"}, {"children": null, "name": "vendor", "type": "string"}, {"children": null, "name": "invoice_number", "type": "string"}, {"children": null, "name": "date", "type": "string"}, {"children": null, "name": "total", "type": "number"}, {"children": null, "name": "tax", "type": "number"}, {"children": null, "name": "confidence", "type": "number"}], "selected": false, "title": "格式化-增值税发票", "type": "code", "variables": [{"value_selector": ["1782813119190", "body"], "variable": "ocr_data"}, {"value_selector": ["1782813119193", "text"], "variable": "llm_fallback"}]}, "height": 52, "id": "1782813119194", "position": {"x": 990, "y": 60}, "positionAbsolute": {"x": 990, "y": 60}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 244}, {"data": {"code": "def main(ocr_data: dict) -> dict:\n    result = {\n        \"status\": \"success\",\n        \"type\": \"小票/收据\",\n        \"merchant\": ocr_data.get(\"vendor_name\", \"未知商户\"),\n        \"date\": ocr_data.get(\"date\", \"\"),\n        \"total\": ocr_data.get(\"total_amount\"),\n        \"items\": ocr_data.get(\"items\", []),\n        \"confidence\": round(ocr_data.get(\"confidence\", 0) * 100, 1),\n        \"note\": \"小票格式多样，建议人工复核金额\"\n    }\n    return result\n", "code_language": "python3", "desc": "格式化小票的识别结果", "outputs": [{"children": null, "name": "status", "type": "string"}, {"children": null, "name": "type", "type": "string"}, {"children": null, "name": "merchant", "type": "string"}, {"children": null, "name": "total", "type": "number"}], "selected": false, "title": "格式化-小票", "type": "code", "variables": [{"value_selector": ["1782813119190", "body"], "variable": "ocr_data"}]}, "height": 52, "id": "1782813119195", "position": {"x": 990, "y": 260}, "positionAbsolute": {"x": 990, "y": 260}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 244}, {"data": {"code": "def main(ocr_data: dict) -> dict:\n    result = {\n        \"status\": \"success\",\n        \"type\": \"交通票据\",\n        \"date\": ocr_data.get(\"date\", \"\"),\n        \"total\": ocr_data.get(\"total_amount\"),\n        \"raw_text\": ocr_data.get(\"raw_text\", \"\")[:200],\n        \"note\": \"交通票据识别精度有限，请手工核对\"\n    }\n    return result\n", "code_language": "python3", "desc": "格式化交通票据的识别结果", "selected": false, "title": "格式化-交通票据", "type": "code", "variables": [{"value_selector": ["1782813119190", "body"], "variable": "ocr_data"}]}, "height": 52, "id": "1782813119196", "position": {"x": 990, "y": 430}, "positionAbsolute": {"x": 990, "y": 430}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 244}, {"data": {"code": "def main(ocr_data: dict) -> dict:\n    return {\n        \"status\": \"success\",\n        \"type\": \"通用票据\",\n        \"raw_text\": ocr_data.get(\"raw_text\", \"\")[:300],\n        \"suggested_action\": \"未能精确识别票据类型，以下为OCR原始文本供参考\"\n    }\n", "code_language": "python3", "desc": "通用票据的降级输出", "selected": false, "title": "格式化-通用", "type": "code", "variables": [{"value_selector": ["1782813119190", "body"], "variable": "ocr_data"}]}, "height": 52, "id": "1782813119197", "position": {"x": 990, "y": 560}, "positionAbsolute": {"x": 990, "y": 560}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 244}, {"data": {"code": "def main(http_response: dict) -> dict:\n    error_msg = \"OCR 识别失败\"\n    status_code = 500\n    if http_response:\n        error_msg = http_response.get(\"error\", str(http_response))\n        status_code = http_response.get(\"status_code\", 500)\n    return {\n        \"status\": \"error\",\n        \"message\": error_msg,\n        \"code\": status_code,\n        \"suggestion\": \"请检查图片是否清晰、格式是否支持（JPG/PNG/BMP/WEBP）\"\n    }\n", "code_language": "python3", "desc": "处理 OCR 失败的情况", "selected": false, "title": "失败处理", "type": "code", "variables": [{"value