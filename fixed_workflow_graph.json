n JUNK_NAMES) or (\"\u9000\u8ba2\" in name)\n        has_content = len(raw_text) > 80 or bool(phone)\n        is_resume = has_content and confidence >= 0.25 and not is_junk\n\n        if is_resume:\n            entry = dict(c)\n            entry[\"raw_text_short\"] = raw_text[:2500]\n            normal.append(entry)\n        else:\n            reason = \"\u89e3\u6790\u7f6e\u4fe1\u5ea6\u4f4e\u6216\u5185\u5bb9\u4e0d\u8db3\uff0c\u9700\u4eba\u5de5\u590d\u6838\"\n            if is_junk:\n                reason = \"\u7591\u4f3c\u8425\u9500\u90ae\u4ef6\"\n            elif not raw_text:\n                reason = \"QQ\u8d85\u5927\u9644\u4ef6\u672a\u4e0b\u8f7d\u6216PDF\u89e3\u6790\u5931\u8d25\"\n            review.append({\n                \"id\": c.get(\"id\"),\n                \"name\": name or \"\u672a\u77e5\",\n                \"reason\": reason,\n            })\n\n    normal = normal[:10]\n    review = review[:20]\n\n    return {\n        \"normal_list\": normal,\n        \"review_list\": review,\n        \"normal_count\": len(normal),\n        \"review_count\": len(review),\n    }", "code_language": "python3", "error_strategy": "fail-branch", "outputs": {"normal_count": {"children": null, "type": "number"}, "normal_list": {"children": null, "type": "array[object]"}, "review_count": {"children": null, "type": "number"}, "review_list": {"children": null, "type": "array[object]"}}, "selected": false, "title": "\u8fc7\u6ee4\u5206\u6d41", "type": "code", "variables": [{"value_selector": ["1782723109454", "body"], "value_type": "string", "variable": "candidates_body"}]}, "height": 87, "id": "1782725211723", "position": {"x": -1060.8433691521225, "y": -131.81787050061163}, "positionAbsolute": {"x": -1060.8433691521225, "y": -131.81787050061163}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 241}, {"data": {"error_handle_mode": "continue-on-error", "flatten_output": true, "height": 293, "is_parallel": false, "iterator_input_t