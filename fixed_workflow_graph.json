}} \u6280\u80fd\uff1a{{#1782725226412.item.skills#}} \u7b80\u5386\u6b63\u6587\uff1a{{#1782725226412.item.raw_text_short#}}\n\u8bf7\u8f93\u51fa\u5339\u914d\u6253\u5206JSON\u3002"}], "retry_config": {"max_retries": 2, "retry_enabled": true, "retry_interval": 2000}, "selected": false, "title": "\u5339\u914d\u6253\u5206", "type": "llm", "vision": {"enabled": false}}, "height": 152, "id": "1782727072077", "parentId": "1782725226412", "position": {"x": 399.6620476077616, "y": 70.6979800864047}, "positionAbsolute": {"x": 294.8945120213367, "y": -186.53615424838353}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 241, "zIndex": 1002}, {"data": {"code": "import json\nimport re\n\ndef main(jd_text: str) -> dict:\n    text = (jd_text or \"\").strip()\n    text = re.sub(r\"^```(?:json)?\\s*\", \"\", text, flags=re.IGNORECASE)\n    text = re.sub(r\"\\s*```$\", \"\", text)\n\n    try:\n        data = json.loads(text)\n    except Exception:\n        data = {\n            \"title\": \"\",\n            \"requirements\": [],\n            \"nice_to_have\": [],\n            \"full_jd_text\": text,\n        }\n\n    return {\n        \"result\": json.dumps(data, ensure_ascii=False),\n        \"full_jd_text\": data.get(\"full_jd_text\") or \"\",\n        \"jd_title\": data.get(\"title\") or \"\",\n    }", "code_language": "python3", "error_strategy": "fail-branch", "outputs": {"full_jd_text": {"children": null, "type": "string"}, "jd_title": {"children": null, "type": "string"}, "result": {"children": null, "type": "string"}}, "retry_config": {"max_retries": 3, "retry_enabled": true, "retry_interval": 1000}, "selected": false, "title": "\u89e3\u6790JD", "type": "code", "variables": [{"value_selector": ["1782722679833", "text"], "value_type": "string", "variable": "jd_text"}]}, "height": 116, "id": "1782786694136", "position": {"x": -370.55616101401876, "y": -340.07666212409424}, "positionAbsolute": {"x": -370.55616101401876, "y": -340.07666212409424}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 241}, {"data": {"code": "import json\nimport re\n\ndef _parse_llm(text: str) -> dict | None:\n    if not text:\n        return None\n    t = text.strip()\n    t = re.sub(r\"^```(?:json)?\\s*\", \"\", t, flags=re.I)\n    t = re.sub(r\"\\s*```$\", \"\", t)\n    try:\n        return json.loads(t)\n    except Exception:\n        return {\"name\": \"\", \"match_score\": 0, \"tier\": \"\u672a\u77e5\", \"match_reason\": t[:300], \"key_points\": [], \"summary_50\": \"\"}\n\ndef main(match_outputs: list, review_list: list, crawl_body: str, full_jd_text: str, jd_title: str, normal_count: int) -> dict:\n    parsed = []\n    for raw in (match_outputs or []):\n        p = _parse_llm(raw)\n        if p:\n            parsed.append(p)\n    parsed.sort(key=lambda x: x.get(\"match_score\") or 0, reverse=True)\n\n    tier1, tier2, tier3 = [], [], []\n    for p in parsed:\n        score = p.get(\"match_score\") or 0\n        tier = str(p.get(\"tier\") or \"\")\n        if score >= 80 or \"\u63a8\u8350\" in tier:\n            tier1.append(p)\n        elif score >= 60 or \"\u5f85\u5b9a\" in tier:\n            tier2.append(p)\n        else:\n            tier3.append(p)\n\n    try:\n        crawl = json.loads(crawl_body) if crawl_body else {}\n    except Exception:\n        crawl = {}\n\n    lines = [\"# \ud83d\udccb \u7b80\u5386\u521d\u7b5b\u62a5\u544a\", \"\"]\n    lines.append(f\"**\u5c97\u4f4d**\uff1a{jd_title or '\uff08\u89c1\u4e0b\u65b9\uff09'}\")\n    lines.append(f\"**\u672c\u8f6e\u8bc4\u5206**\uff1a{len(parsed)} \u4eba | **\u8fdb\u5165\u5339\u914d\u6c60**\uff1a{normal_count} \u4eba\")\n    lines.append(\"\")\n\n    if crawl:\n        lines.append(\"## \ud83d\udcec \u62c9\u4fe1\u6458\u8981\")\n        lines.append(f\"- \u5904\u7406\u90ae\u4ef6\uff1a{crawl.get('emails_processed', '?')} \u5c01\")\n        lines.append(f\"- \u672c\u8f6e\u65b0\u89e3\u6790\uff1a{crawl.get('parsed', '?')} \u4efd\uff080 \u8868\u793a\u6cbf\u7528\u5386\u53f2\u89e3\u6790\u7ed3\u679c\uff09\")\n        lines.append(f\"- \u540c\u6b65\u4eba\u624d\u5e93\uff1a{crawl.get('candidates_synced', '?')} \u4eba\")\n        errs = crawl.get('errors') or []\n        if errs:\n            lines.append(f\"- \u26a0\ufe0f \u9644\u4ef6\u4e0b\u8f7d\u5931\u8d25\uff1a{len(errs)} \u6761\uff08QQ\u8d85\u5927\u9644\u4ef6\u9700Cookie\u6216\u624b\u52a8\u4e0a\u4f20\uff09\")\n        lines.append(\"\")\n\n    jd = (full_jd_text or \"\").strip()\n    if jd:\n        lines.append(\"## \ud83d\udccc \u5c97\u4f4d\u8981\u6c42\")\n        lines.append(jd[:600])\n        lines.append(\"\")\n\n    def block(title: str, rows: list, icon: str):\n        if not rows:\n            return\n        lines.append(f\"## {icon} {title}\uff08{len(rows)} \u4eba\uff09\")\n        lines.append(\"\")\n        for i, p in enumerate(rows, 1):\n            name = p.get(\"name\") or \"\u672a\u77e5\"\n            score = p.get(\"match_score\") or 0\n            lines.append(f\"### {i}. {name} \u00b7 {score} \u5206 \u00b7 {p.get('tier') or '-'}\")\n            if p.get(\"summary_50\"):\n                lines.append(f\"> {p['summary_50']}\")\n            if p.get(\"match_reason\"):\n                lines.append(f\"**\u5206\u6790**\uff1a{p['match_reason']}\")\n            kps = p.get(\"key_points\") or []\n            if kps:\n                lines.append(\"**\u8981\u70b9**\uff1a\" + \" \u00b7 \".join(str(k) for k in kps[:8]))\n            lines.append(\"\")\n\n    block(\"\u63a8\u8350\u9762\u8bd5\uff0880+\uff09\", tier1, \"\ud83d\udfe2\")\n    block(\"\u5f85\u5b9a / \u8fdb\u4e00\u6b65\u4e86\u89e3\uff0860-79\uff09\", tier2, \"\ud83d\udfe1\")\n    block(\"\u5f52\u6863 / \u6682\u4e0d\u63a8\u8350\uff08<60\uff09\", tier3, \"\ud83d\udd34\")\n\n    reviews = review_list if isinstance(review_list, list) else []\n    if reviews:\n        lines.append(\"## \u26a0\ufe0f \u9700\u4eba\u5de5\u590d\u6838\")\n        for r in reviews:\n            if isinstance(r, dict):\n                lines.append(f\"- **{r.get('name','?')}**\uff1a{r.get('reason','')}\")\n        lines.append(\"\")\n\n    if not parsed:\n        lines.append(\"## \u2757 \u63d0\u793a\")\n        lines.append(\"\u672c\u8f6e\u672a\u4ea7\u751f\u6709\u6548\u8bc4\u5206 JSON\uff0c\u8bf7\u68c0\u67e5\u300c\u5339\u914d\u6253\u5206\u300dLLM \u8282\u70b9\u662f\u5426\u62a5\u9519\u3002\")\n        lines.append(\"\")\n\n    lines.append(\"---\")\n    lines.append(\"*\u81ea\u52a8\u521d\u7b5b\u4ec5\u4f9b\u53c2\u8003\uff0c\u9762\u8bd5\u51b3\u7b56\u8bf7 HR \u6700\u7ec8\u786e\u8ba4\u3002*\")\n    return {\"report\": \"\\n\".join(lines)}", "code_language": "python3", "outputs": {"report": {"children": null, "type": "string"}}, "title": "\u6c47\u603b\u62a5\u544a", "type": "code", "variables": [{"value_selector": ["1782725226412", "output"], "value_type": "array[string]", "variable": "match_outputs"}, {"value_selector": ["1782725211723", "review_list"], "value_type": "array[object]", "variable": "review_list"}, {"value_selector": ["1782706958988", "body"], "value_type": "string", "variable": "crawl_body"}, {"value_selector": ["1782786694136", "full_jd_text"], "value_type": "string", "variable": "full_jd_text"}, {"value_selector": ["1782786694136", "jd_title"], "value_type": "string", "variable": "jd_title"}, {"value_selector": ["1782725211723", "normal_count"], "value_type": "number", "variable": "normal_count"}], "selected": false}, "height": 51, "id": "1782790100001", "position": {"x": 520, "y": -120}, "positionAbsolute": {"x": 520, "y": -120}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "type": "custom", "width": 241}], "edges": [{"data": {"isInLoop": false, "sourceType": "code", "targetType": "llm"}, "id": "1782725211723-source-1782722679833-target", "selected": false, "source": "1782725211723", "sourceHandle": "source", "target": "1782722679833", "targetHandle": "target", "type": "custom", "zIndex": 0}, {"data": {"